<mujoco model="soccer">
  <compiler angle="radian" meshdir="../mesh/"/>

  <asset>
    <mesh name="soccer" content_type="model/stl" file="soccer.stl" scale="0.115 0.115 0.115"/>
  </asset>

  <worldbody>
    <body name="soccer" pos = "0 0.4 0.8">
      <inertial pos="0 0 0" mass="0.43" diaginertia="0.0035 0.0035 0.0035"/>
      <joint name="soccer_freejoint" type="free"/>
      <!-- mesh geom: visual only, no collision -->
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="soccer"/>
      <!-- sphere geom: sole collision body for ball-robot and ball-ground contacts -->
      <!-- solref: [timeconst, dampratio]
           timeconst=0.008s  : shorter contact duration => snappier response
           dampratio=0.05    : very low damping => highly elastic bounce (~COR 0.85-0.9)
           (was: 0.01 / 0.3 => COR ~0.7) -->
      <!-- solimp: [dmin, dmax, width, midpoint, power]
           dmin=0.95, dmax=0.998: stiffer impedance limits deep penetration,
           concentrating impulse for a cleaner, higher bounce -->
      <geom size="0.11" condim="3"
            friction="0.6 0.01 0.001"
            solref="0.008 0.05"
            solimp="0.95 0.995 0.001"/>
    </body>
  </worldbody>
</mujoco>
