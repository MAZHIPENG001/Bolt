<!-- Description: 
调整球的碰撞参数，使其从1m落下时与实际反弹高度近似 
friction="0.6 0.005 0.0001"
solref="0.04 0.2"
solimp="0.9 0.95 0.001"/>
-->
<mujoco model="soccer">
  <compiler angle="radian" meshdir="../mesh/"/>

  <asset>
    <mesh name="soccer" content_type="model/stl" file="soccer.stl" scale="0.115 0.115 0.115"/>
  </asset>

  <worldbody>
    <body name="soccer" pos = "0.4 0.0 1.0">
      <inertial pos="0 0 0" mass="0.43" diaginertia="0.0035 0.0035 0.0035"/>
      <joint name="soccer_freejoint" type="free"/>
      <!-- mesh geom: visual only, no collision -->
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" mesh="soccer"/>
      <!-- sphere geom: sole collision body for ball-robot and ball-ground contacts.
           priority=1 使球在 ball-floor / ball-foot 接触时整体覆盖对方参数，
           避免走 MuJoCo 默认混合规则 (solmix 加权平均 + friction 逐元素 max)。
           参数中心来自 test_soccer_bounce_demo.py 的 G_center (COR ≈ 0.54)。
           solref=[timeconst, dampratio], solimp=[dmin, dmax, width]。 -->
      <geom size="0.11" condim="3" priority="2"
            friction="0.6 0.005 0.0001"
            solref="0.04 0.24"
            solimp="0.9 0.95 0.001"/>
    </body>
  </worldbody>
</mujoco>
