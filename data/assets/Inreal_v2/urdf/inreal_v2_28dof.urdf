<?xml version="1.0" ?>
<!-- InReal V2_1 无碰撞模型版URDF，请根据实际情况进行处理 -->
<!-- 默认模型考虑前后脚掌的作用，如果需要刚性脚，请设置为fix joint -->
<!-- 机器人从胸腔开始建模，分别是胸腔，左手，右手，腰，左腿，右腿 -->
<!-- 关节运动范围不严格准确，如果训练碰到角度边界，需要进一步确认 -->
<!-- 该模型胸腔不包含电池的质量、惯量 -->
<!-- 前臂质量、惯量可能还和实物有出入，与实物打印的填充率，材料有关，待进一步确认 -->
<!-- copyright @ woodenjin -->

