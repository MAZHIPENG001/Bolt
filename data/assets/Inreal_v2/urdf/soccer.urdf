<?xml version="1.0" ?>

<robot name="soccer">
    <mujoco>
        <compiler meshdir="../mesh" discardvisual="false"/>
    </mujoco>

    <!-- 世界坐标系 -->
    <!-- <link name="world"/> -->
    <!-- LINK define -->
    <link name="soccer">
        <inertial>
            <origin xyz="0 0.0 0.0"/>
            <mass value="0.430"/>
            <inertia ixx="0.0035" ixy="0.0" ixz="0.0" iyy="0.0035" iyz="0.0" izz="0.0035"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/soccer.stl" scale="0.115 0.115 0.115"/>
            </geometry>
        </visual>
        <!-- 碰撞模型 -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.11"/>
            </geometry>
        </collision>
    </link>

    <!-- 自由关节（6自由度：3平移+3旋转） -->
    <!-- <joint name="shuttlecock_joint" type="floating">
        <parent link="world"/>
    </joint> -->

</robot>